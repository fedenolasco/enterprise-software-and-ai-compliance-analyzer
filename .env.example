# PostgreSQL
POSTGRES_DB=compliance_analyzer
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=compliance_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://compliance_user:compliance_password@localhost:5432/compliance_analyzer?schema=public

# Neo4j
NEO4J_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH=neo4j/compliance_password

# Application ports
MOCK_PRICING_API_PORT=8000

# Embeddings
EMBEDDING_DIMENSION=8
