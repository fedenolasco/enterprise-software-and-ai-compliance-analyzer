# Local environment files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python virtual environments
**/.venv/
**/.venv-*/
**/venv/
**/env/

# Python caches and tooling
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# Jupyter runtime checkpoints
**/.ipynb_checkpoints/

# Node.js dependencies and build outputs
**/node_modules/
**/dist/
**/build/

# Local logs and editor files
*.log
.vscode/

# Playwright MCP cache
.playwright-mcp/

# Local OpenVINO runtime data and downloaded model repositories.
# Keep this outside the workspace when possible so Roo Code checkpoints are not
# disabled by nested Hugging Face/OpenVINO Git repositories.
.openvino/

# Next.js build output
**/.next/

# Foundry Local model cache and downloaded models (2-10 GB each)
# Foundry Local stores models in ~/.cache/foundry-local/ on Linux/macOS
# and %USERPROFILE%\.cache\foundry-local\ on Windows
**/.foundry-local/
**/foundry-local-cache/
**/.cache/foundry-local/
*.onnx
*.gguf
*.bin
# Allow small test fixtures that might use .bin extension
!**/tests/**/*.bin
!**/test/**/*.bin

# Large model artifacts and checkpoints
**/models/*.pt
**/models/*.pth
**/models/*.safetensors
**/checkpoints/

# Docker volumes (local data)
**/docker-data/
**/pgdata/
**/neo4j-data/
