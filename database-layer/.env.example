DATABASE_URL=postgresql://compliance_user:compliance_password@localhost:5432/compliance_analyzer?schema=public

# Embedding configuration
# Provider: placeholder (default), microsoft-foundry-local, or openai
EMBEDDING_DIMENSION=8
EMBEDDING_PROVIDER=placeholder
EMBEDDING_MODEL=deterministic-placeholder

# Foundry Local (required when EMBEDDING_PROVIDER=microsoft-foundry-local)
FOUNDRY_LOCAL_ENDPOINT=http://localhost:5272

# OpenAI API (required when EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
