# PostgreSQL + pgvector
DATABASE_URL=postgresql://compliance_user:compliance_password@localhost:5432/compliance_analyzer?schema=public

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=compliance_password

# Retrieval defaults
EMBEDDING_DIMENSION=8
EMBEDDING_PROVIDER=placeholder
EMBEDDING_MODEL=deterministic-placeholder
VECTOR_TOP_K=5
GRAPH_RESULT_LIMIT=25

# Model provider: placeholder, microsoft-foundry-local, or openai
MODEL_PROVIDER=placeholder
LOCAL_MODEL_NAME=deterministic-placeholder-local-model
FOUNDRY_LOCAL_ENDPOINT=http://localhost:5272

# OpenAI API (required when MODEL_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Phase 4 observability exports
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_GRPC_ENDPOINT=http://localhost:4317
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-local-development-placeholder
LANGFUSE_SECRET_KEY=sk-lf-local-development-placeholder
