# PostgreSQL + pgvector
DATABASE_URL=postgresql://compliance_user:compliance_password@localhost:5432/compliance_analyzer?schema=public

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=compliance_password

# Retrieval defaults
EMBEDDING_DIMENSION=8
EMBEDDING_PROVIDER=placeholder
EMBEDDING_MODEL=deterministic-placeholder
VECTOR_TOP_K=5
GRAPH_RESULT_LIMIT=25

# Model provider: placeholder, microsoft-foundry-local, openvino, or openai
MODEL_PROVIDER=placeholder
LOCAL_MODEL_NAME=deterministic-placeholder-local-model
FOUNDRY_LOCAL_ENDPOINT=http://localhost:5272
# OpenVINO Model Server runs bare-metal on Windows for direct Intel NPU/GPU/CPU access.
# Start it from the repository root with: powershell -ExecutionPolicy Bypass -File scripts/setup-ovms.ps1 -Start
OPENVINO_ENDPOINT=http://localhost:8100
OPENVINO_MODEL=OpenVINO/Qwen3-8B-int4-cw-ov
OPENVINO_EMBEDDING_MODEL=OpenVINO/Qwen3-Embedding-0.6B
OPENVINO_DEVICE=NPU
# Optional: absolute path to ovms.exe if it is not on PATH.
# OPENVINO_OVMS_PATH=C:\tools\ovms\2026.2.1\ovms.exe
# Optional: only required for gated/private Hugging Face models or higher download limits.
# HF_TOKEN=hf-your-token-here

# OpenAI API (required when MODEL_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Phase 4 observability exports
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_GRPC_ENDPOINT=http://localhost:4317
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-local-development-placeholder
LANGFUSE_SECRET_KEY=sk-lf-local-development-placeholder
